---
interface Props {
  art: string;
  id?: string;
  variant?: 'full' | 'card';
  label?: string;
}
const { art, variant = 'full', label = 'system-prompt' } = Astro.props;
---
{variant === 'full' ? (
  <figure class="ascii">
    <div class="ascii-bar">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <em class="ascii-label">{label} — doodlepad</em>
      <span class="ascii-hint" aria-hidden="true">psst, click to scribble ✎</span>
    </div>
    <pre class="ascii-body"><code
      data-ascii-art
      contenteditable="plaintext-only"
      spellcheck="false"
      role="textbox"
      aria-multiline="true"
      aria-label="ASCII doodle, click to edit it"
    >{art}</code></pre>
  </figure>
) : (
  <div class="ascii-card" role="img" aria-hidden="true">
    <pre class="ascii-card-body"><code>{art}</code></pre>
  </div>
)}
<style>
  .ascii {
    margin: 0 0 var(--sp-12);
    max-width: var(--measure);
    background: var(--term-bg);
    border: 1px solid #2a2a22;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 18px 40px -28px rgba(0,0,0,.5);
    transform: rotate(-0.6deg);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur);
  }
  .ascii:hover, .ascii:focus-within {
    transform: rotate(0deg);
    box-shadow: 0 22px 48px -26px rgba(0,0,0,.55);
  }
  .ascii:focus-within { border-color: #3ba55c88; }
  @media (prefers-reduced-motion: reduce) {
    .ascii { transform: none; transition: box-shadow var(--dur) var(--ease), border-color var(--dur); }
  }

  .ascii-bar { display: flex; align-items: center; gap: 6px; padding: .5rem .8rem; border-bottom: 1px solid #2a2a22; }
  .ascii-bar > .dot { width: 11px; height: 11px; border-radius: 999px; background: #3a3a30; flex: none; }
  .ascii-bar > .dot:nth-child(1) { background: #e0603a; }
  .ascii-bar > .dot:nth-child(2) { background: #e0b23a; }
  .ascii-bar > .dot:nth-child(3) { background: #3ba55c; }
  .ascii-label { margin-left: 8px; font: 400 var(--fs-xs)/1 var(--font-mono); color: #77776b; font-style: normal; }
  .ascii-hint {
    margin-left: auto; font: 400 var(--fs-xs)/1 var(--font-mono); color: #6f6f63;
    white-space: nowrap; opacity: 0; transition: opacity var(--dur) var(--ease);
  }
  .ascii:hover .ascii-hint { opacity: .8; }
  .ascii:focus-within .ascii-hint { opacity: 0; }

  .ascii-body {
    margin: 0; padding: var(--sp-6) var(--sp-4);
    font: 400 clamp(9px, 1.7vw, 13px)/1.4 var(--font-mono);
    color: var(--term-green);
    text-align: center; overflow-x: auto; cursor: text;
  }
  .ascii-body code {
    display: inline-block; text-align: left; white-space: pre;
    outline: none; caret-color: var(--term-green);
  }

  /* Compact "terminal cover" for cards */
  .ascii-card {
    background: var(--term-bg);
    border: 1px solid #2a2a22;
    border-radius: var(--radius-sm);
    height: 116px;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    margin-bottom: var(--sp-4);
    transition: transform var(--dur) var(--ease);
  }
  .card:hover .ascii-card { transform: rotate(-1deg) scale(1.02); }
  @media (prefers-reduced-motion: reduce) { .card:hover .ascii-card { transform: none; } }
  .ascii-card-body {
    margin: 0;
    font: 400 6.5px/1.32 var(--font-mono);
    color: var(--term-green);
    white-space: pre;
    opacity: .92;
  }
</style>
<script is:inline>
  // Make the doodlepad editable everywhere: keep plaintext-only where supported,
  // fall back to plain contenteditable where it isn't.
  (() => {
    document.querySelectorAll('code[data-ascii-art]').forEach((el) => {
      if (el.contentEditable !== 'plaintext-only') el.setAttribute('contenteditable', 'true');
    });
  })();
</script>
